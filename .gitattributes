# 统一换行符策略：仓库内与工作区一律 LF
* text=auto eol=lf

# Windows 原生脚本必须保持 CRLF，否则 cmd/powershell 可能解析异常
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件：不参与换行符转换与文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.jar   binary
*.woff  binary
*.woff2 binary
